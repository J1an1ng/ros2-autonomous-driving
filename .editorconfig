root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 99

[*.{c,cc,cpp,cxx,h,hpp}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{yaml,yml,json,xml}]
indent_style = space
indent_size = 2

# Do not let editor defaults rewrite bundled/generated third-party content.
[project/src/dummy_controller/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
max_line_length = unset
trim_trailing_whitespace = unset

[project/src/perception/third_party/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
max_line_length = unset
trim_trailing_whitespace = unset

[project/src/simulation/src/json_nlohmann/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
max_line_length = unset
trim_trailing_whitespace = unset

[project/src/simulation/unity_sim/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
max_line_length = unset
trim_trailing_whitespace = unset

[Makefile]
indent_style = tab
