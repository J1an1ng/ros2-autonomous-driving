<?xml version="1.0"?>
<package format="3">
  <name>r2d2</name>
  <version>0.0.0</version>
  <description>The r2d2 package, converted to ROS 2 Jazzy.</description>
  <maintainer email="jonarriza96@todo.todo">jonarriza96</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
