digraph team20_ros_graph {
  graph [
    bgcolor="white",
    compound=true,
    fontname="DejaVu Sans",
    label="Team 20 runtime ROS 2 node/topic graph and contribution ownership",
    labelloc="t",
    fontsize=20,
    pad=0.25,
    rankdir=LR,
    splines=polyline
  ];
  node [
    color="#455a64",
    fillcolor="#f7f9fb",
    fontname="DejaVu Sans",
    fontsize=10,
    margin="0.14,0.08",
    shape=box,
    style="rounded,filled"
  ];
  edge [color="#546e7a", fontname="DejaVu Sans", fontsize=8];

  subgraph cluster_simulation {
    color="#9e9e9e";
    fillcolor="#f5f5f5";
    label="simulation — course-supplied/reused";
    style="rounded,filled";
    simulation_config [label="simulation_config.json", shape=note];
    json_reader [label="JSON_param_reader\n(startup configuration check)"];
    unity_receiver [label="Unity_ROS_message_Rx"];
    command_transmitter [label="ROS_Unity_command_Tx"];
    sensor_tf [label="static_transform_publishers"];
  }

  subgraph cluster_perception {
    color="#66bb6a";
    fillcolor="#e8f5e9";
    label="perception — Tao Zhang";
    style="rounded,filled";
    yolo [label="yolo_rgbd_detector_node"];
    occupancy [label="occupancy_map_node"];
    octomap [label="octomap_server_node"];
  }

  subgraph cluster_route {
    color="#ffb74d";
    fillcolor="#fff3e0";
    label="route_manager — Lei Fang";
    style="rounded,filled";
    route [label="route_manager_node"];
  }

  subgraph cluster_trajectory {
    color="#42a5f5";
    fillcolor="#e3f2fd";
    label="trajectory_generator + autonomy_interfaces — Jianing Huang";
    style="rounded,filled";
    trajectory [label="trajectory_generator_node"];
  }

  subgraph cluster_decision {
    color="#ab47bc";
    fillcolor="#f3e5f5";
    label="decision_making — Yida Lyu";
    style="rounded,filled";
    obstacle [label="obstacle_monitor_node"];
    state_machine [label="traffic_light_state_machine_node"];
  }

  subgraph cluster_controller {
    color="#7e57c2";
    fillcolor="#ede7f6";
    label="controller — Yida Lyu";
    style="rounded,filled";
    controller [label="controller_node"];
  }

  integration [
    color="#00838f",
    fillcolor="#e0f7fa",
    label="system_bringup/full_system.launch.py\nshared integration: Yida Lyu / Tao Zhang / Jianing Huang",
    shape=component
  ];

  unity_receiver -> yolo [
    label="/OurCar/Sensors/RGBCameraLeft/{image_raw,camera_info}\n/OurCar/Sensors/DepthCamera/{image_raw,camera_info}"
  ];
  unity_receiver -> occupancy [label="Depth image + CameraInfo"];
  occupancy -> octomap [label="/perception/pcl/points_preprocessed"];
  occupancy -> obstacle [
    label="/perception/pcl/points\n/perception/pcl/points_preprocessed"
  ];
  sensor_tf -> yolo [label="/tf_static"];
  sensor_tf -> occupancy [label="/tf_static"];
  sensor_tf -> obstacle [label="/tf_static"];
  unity_receiver -> route [label="/tf: world -> OurCar/INS"];
  unity_receiver -> trajectory [label="/OurCar/INS/twist + /tf"];
  unity_receiver -> controller [label="/OurCar/INS/twist + /tf"];
  unity_receiver -> state_machine [label="/OurCar/INS/twist"];

  route -> trajectory [
    label="/route/local_path, /route/target_pose\n/route/speed_limit, /route/route_state"
  ];
  route -> yolo [label="/route/current_waypoint_{id,distance}"];
  route -> obstacle [label="waypoint ID + distance"];
  route -> state_machine [label="waypoint ID + distance + route state"];

  yolo -> state_machine [label="/perception/traffic_light_state"];
  yolo -> obstacle [
    label="/perception/front_vehicle_detected\n/perception/front_vehicle_distance"
  ];
  obstacle -> state_machine [
    label="/decision/front_obstacle_distance\n/decision/merge_obstacle_distance"
  ];
  trajectory -> state_machine [label="/planning/target_speed"];
  trajectory -> obstacle [label="/planning/path"];
  trajectory -> controller [
    color="#1565c0",
    label="/planning/trajectory\nTeam 20 PlannedTrajectory"
  ];
  state_machine -> controller [
    label="/decision/target_speed\n/decision/stop_required"
  ];
  controller -> command_transmitter [label="/car_command"];

  integration -> unity_receiver [style=dotted, arrowhead=none];
  integration -> json_reader [style=dotted, arrowhead=none];
  simulation_config -> json_reader [label="file input", style=dashed];
  simulation_config -> unity_receiver [label="file input", style=dashed];
  simulation_config -> command_transmitter [label="file input", style=dashed];
  integration -> yolo [style=dotted, arrowhead=none];
  integration -> route [style=dotted, arrowhead=none];
  integration -> trajectory [style=dotted, arrowhead=none];
  integration -> state_machine [style=dotted, arrowhead=none];
  integration -> controller [style=dotted, arrowhead=none];
}
