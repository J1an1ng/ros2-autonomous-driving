  <version>0.1.0</version>
  <description>Single launch entry point for staged full-system integration.</description>
  <maintainer email="team20@todo.todo">Team 20</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller</exec_depend>
  <exec_depend>decision_making</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>perception</exec_depend>
  <exec_depend>route_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>simulation</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>trajectory_generator</exec_depend>
