Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 90; 90; 95
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: World grid
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: world
      Value: true
    - Alpha: 0.65
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: 2D obstacle map
      Topic: /perception/extended_map
      Update Topic: /perception/extended_map_updates
      Use Timestamp: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 170; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.18
      Name: Route local path
      Offset:
        X: 0
        Y: 0
        Z: 0.3
      Pose Style: None
      Queue Size: 10
      Radius: 0.03
      Topic: /route/local_path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 85; 255; 85
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.28
      Name: Generated planning path
      Offset:
        X: 0
        Y: 0
        Z: 0.42
      Pose Style: None
      Queue Size: 10
      Radius: 0.03
      Topic: /planning/path
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Vehicle trace
      Namespaces:
        vehicle_trace: true
      Queue Size: 100
      Topic: /visualization/vehicle_trace
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 3
      Name: Vehicle
      Radius: 0.18
      Reference Frame: OurCar/INS
      Show Trail: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 25; 27; 32
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: 2D route overview
      Scale: 4
      Target Frame: OurCar/INS
      X: 0
      Y: 0
Window Geometry:
  Height: 760
  Width: 1100
  X: 20
  Y: 20
